---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: `/img/${string}`;
  alt: string;
};

type Source = {
  width: number;
  src: string;
};

type RenderedImage = {
  src: string;
  srcset: string;
  width: number;
  height: number;
};

type ResolvedImage =
  | {
      kind: 'single';
      image: ImageMetadata;
    }
  | {
      kind: 'themed';
      light: ImageMetadata;
      dark: ImageMetadata;
    };

const { src, alt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{avif,jpeg,jpg,png,webp}', {
  eager: true,
});

const extensions = ['png', 'jpg', 'jpeg', 'webp', 'avif'];
const sourcePath = src.replace(/^\/img\//, '../assets/images/').replace(/\/$/, '');
const resolvedImage = resolveImage(sourcePath);
const sizes = '(min-width: 72rem) 48rem, calc(100vw - 2rem)';

const renderedImage =
  resolvedImage.kind === 'single'
    ? { kind: 'single' as const, image: await renderImage(resolvedImage.image) }
    : {
        kind: 'themed' as const,
        light: await renderImage(resolvedImage.light),
        dark: await renderImage(resolvedImage.dark),
      };

function resolveImage(sourcePath: string): ResolvedImage {
  const themedBasePath = stripExtension(sourcePath);
  const lightPath = findAsset(`${themedBasePath}/light`);
  const darkPath = findAsset(`${themedBasePath}/dark`);

  if (lightPath || darkPath) {
    if (!lightPath || !darkPath) {
      throw new Error(
        `DocsImage found an incomplete themed image pair for "${src}". Expected both "${themedBasePath}/light.*" and "${themedBasePath}/dark.*".`,
      );
    }

    const light = images[lightPath]?.default;
    const dark = images[darkPath]?.default;

    if (!light || !dark) {
      throw new Error(`DocsImage could not load themed image assets for "${src}".`);
    }

    if (light.width !== dark.width || light.height !== dark.height) {
      throw new Error(
        `DocsImage themed variants for "${src}" must have matching dimensions. Light is ${light.width}x${light.height}; dark is ${dark.width}x${dark.height}.`,
      );
    }

    return { kind: 'themed', light, dark };
  }

  const singlePath = findAsset(sourcePath);

  if (!singlePath) {
    throw new Error(
      `DocsImage could not find image asset for "${src}". Expected either "${sourcePath}.*" or "${themedBasePath}/light.*" and "${themedBasePath}/dark.*".`,
    );
  }

  const image = images[singlePath]?.default;

  if (!image) {
    throw new Error(`DocsImage could not load image asset for "${src}" at "${singlePath}".`);
  }

  return { kind: 'single', image };
}

function findAsset(path: string) {
  if (images[path]) return path;

  const matches = extensions.map((extension) => `${path}.${extension}`).filter((candidate) => images[candidate]);

  if (matches.length > 1) {
    throw new Error(
      `DocsImage found multiple image assets for "${src}" at "${path}". Use a file extension or remove duplicate variants.`,
    );
  }

  return matches[0];
}

function stripExtension(path: string) {
  const slashIndex = path.lastIndexOf('/');
  const dotIndex = path.lastIndexOf('.');

  if (dotIndex <= slashIndex) return path;

  return path.slice(0, dotIndex);
}

async function renderImage(image: ImageMetadata): Promise<RenderedImage> {
  const sources = await getResponsiveSources(image, getWidths(image.width));
  const fallback = sources.at(-1);

  if (!fallback) {
    throw new Error(`DocsImage could not generate optimized sources for "${src}".`);
  }

  return {
    src: fallback.src,
    srcset: toSrcSet(sources),
    width: image.width,
    height: image.height,
  };
}

async function getResponsiveSources(image: ImageMetadata, widths: number[]) {
  return Promise.all(
    widths.map(async (width) => {
      const optimized = await getImage({
        src: image,
        width,
        format: 'webp',
        quality: 82,
      });

      return { width, src: optimized.src };
    }),
  );
}

function getWidths(sourceWidth: number) {
  return [480, 768, 1024, 1280, sourceWidth].filter((width, index, widths) => {
    return width <= sourceWidth && widths.indexOf(width) === index;
  });
}

function toSrcSet(sources: Source[]) {
  return sources.map(({ width, src }) => `${src} ${width}w`).join(', ');
}
---

<img
  class="docs-image"
  src={renderedImage.kind === 'single' ? renderedImage.image.src : renderedImage.light.src}
  srcset={renderedImage.kind === 'single' ? renderedImage.image.srcset : renderedImage.light.srcset}
  data-docs-image={renderedImage.kind === 'themed' ? true : undefined}
  data-light-src={renderedImage.kind === 'themed' ? renderedImage.light.src : undefined}
  data-light-srcset={renderedImage.kind === 'themed' ? renderedImage.light.srcset : undefined}
  data-dark-src={renderedImage.kind === 'themed' ? renderedImage.dark.src : undefined}
  data-dark-srcset={renderedImage.kind === 'themed' ? renderedImage.dark.srcset : undefined}
  sizes={sizes}
  width={renderedImage.kind === 'single' ? renderedImage.image.width : renderedImage.light.width}
  height={renderedImage.kind === 'single' ? renderedImage.image.height : renderedImage.light.height}
  alt={alt}
  loading="lazy"
  decoding="async"
/>

<script>
  const docsImages = document.querySelectorAll('img[data-docs-image]');

  function selectedTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateDocsImages() {
    const theme = selectedTheme();

    for (const image of docsImages) {
      if (!(image instanceof HTMLImageElement)) continue;

      const src = image.dataset[`${theme}Src`];
      const srcset = image.dataset[`${theme}Srcset`];

      if (src) image.src = src;
      if (srcset) image.srcset = srcset;
    }
  }

  updateDocsImages();

  new MutationObserver(updateDocsImages).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
