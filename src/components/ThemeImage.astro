---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: `/img/${string}`;
  alt: string;
};

const { src, alt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{avif,jpeg,jpg,png,webp}', {
  eager: true,
});

const sourcePath = src.replace(/^\/img\//, '../assets/images/');
const extensionIndex = sourcePath.lastIndexOf('.');
const lightSourcePath =
  extensionIndex === -1
    ? sourcePath
    : `${sourcePath.slice(0, extensionIndex)}-light${sourcePath.slice(extensionIndex)}`;

const darkImage = images[sourcePath]?.default;
const lightImage = images[lightSourcePath]?.default ?? darkImage;

if (!darkImage) {
  throw new Error(`ThemeImage could not find image asset for "${src}" at "${sourcePath}".`);
}

const widths = getWidths(darkImage.width);
const darkSources = await getResponsiveSources(darkImage, widths);
const lightSources = await getResponsiveSources(lightImage, widths);
const darkFallback = darkSources.at(-1);
const lightFallback = lightSources.at(-1);

if (!darkFallback || !lightFallback) {
  throw new Error(`ThemeImage could not generate optimized sources for "${src}".`);
}

const width = darkImage.width;
const height = darkImage.height;
const sizes = '(min-width: 72rem) 48rem, calc(100vw - 2rem)';

async function getResponsiveSources(image: ImageMetadata, widths: number[]) {
  return Promise.all(
    widths.map(async (width) => {
      const optimized = await getImage({
        src: image,
        width,
        format: 'webp',
        quality: 82,
      });

      return { width, src: optimized.src };
    }),
  );
}

function getWidths(sourceWidth: number) {
  return [480, 768, 1024, 1280, sourceWidth].filter((width, index, widths) => {
    return width <= sourceWidth && widths.indexOf(width) === index;
  });
}

function toSrcSet(sources: { width: number; src: string }[]) {
  return sources.map(({ width, src }) => `${src} ${width}w`).join(', ');
}
---

<img
  src={lightFallback.src}
  srcset={toSrcSet(lightSources)}
  data-theme-image
  data-light-src={lightFallback.src}
  data-light-srcset={toSrcSet(lightSources)}
  data-dark-src={darkFallback.src}
  data-dark-srcset={toSrcSet(darkSources)}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  loading="lazy"
  decoding="async"
/>

<script>
  const themeImages = document.querySelectorAll('img[data-theme-image]');

  function selectedTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateThemeImages() {
    const theme = selectedTheme();

    for (const image of themeImages) {
      if (!(image instanceof HTMLImageElement)) continue;

      const src = image.dataset[`${theme}Src`];
      const srcset = image.dataset[`${theme}Srcset`];

      if (src) image.src = src;
      if (srcset) image.srcset = srcset;
    }
  }

  updateThemeImages();

  new MutationObserver(updateThemeImages).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
