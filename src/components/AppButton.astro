---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

type ButtonTone = 'neutral' | 'primary' | 'danger';
type ButtonVariant = 'soft' | 'solid' | 'ghost';
type ButtonSize = 'sm' | 'md' | 'lg';
type IconPlacement = 'start' | 'end';

interface Props {
  href: string;
  icon?: StarlightIcon;
  iconPlacement?: IconPlacement;
  label?: string;
  tone?: ButtonTone;
  variant?: ButtonVariant;
  size?: ButtonSize;
  target?: string;
  rel?: string;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  icon,
  iconPlacement = 'start',
  label,
  tone = 'neutral',
  variant = 'soft',
  size = 'md',
  target,
  rel,
  class: className,
  ariaLabel,
} = Astro.props;

const baseButtonClass =
  'inline-flex shrink-0 cursor-pointer select-none items-center justify-center rounded-[8px] border leading-none whitespace-nowrap font-medium no-underline transition-[background-color,border-color,color] duration-150 active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';

const sizeClasses = {
  sm: 'h-8 px-3 gap-1.5 text-xs',
  md: 'h-9 px-3 gap-2 text-sm',
  lg: 'h-10 px-4 gap-2 text-sm',
};

const neutralSurfaceHoverClass =
  'hover:bg-[color-mix(in_srgb,var(--color-text)_6%,var(--color-card))] dark:hover:bg-[color-mix(in_srgb,var(--color-text)_9%,var(--color-card))]';

const variantClasses = {
  neutral: {
    soft: `bg-card text-text-strong border-[color-mix(in_srgb,var(--color-text)_4%,var(--color-border))] dark:border-border shadow-control ${neutralSurfaceHoverClass} hover:border-text/15`,
    solid: `bg-card text-text-strong border-[color-mix(in_srgb,var(--color-text)_4%,var(--color-border))] dark:border-border shadow-control ${neutralSurfaceHoverClass} hover:border-text/15`,
    ghost: `bg-transparent border-transparent text-text-secondary ${neutralSurfaceHoverClass} hover:text-text-strong`,
  },
  primary: {
    soft:
      'bg-primary/10 text-primary-text border-primary/15 shadow-control hover:bg-primary/20 dark:hover:bg-primary/15 hover:border-primary/30 dark:border-primary/30 dark:hover:border-primary/45',
    solid: 'bg-primary text-primary-contrast border-transparent font-semibold shadow-control hover:bg-primary-hover',
    ghost: 'bg-transparent border-transparent text-primary hover:bg-primary/10',
  },
  danger: {
    soft:
      'bg-danger/10 text-danger border-danger/15 shadow-control hover:bg-danger/20 dark:hover:bg-danger/15 hover:border-danger/30 dark:border-danger/30 dark:hover:border-danger/45',
    solid: 'bg-danger text-white border-transparent font-semibold shadow-control hover:bg-danger-hover',
    ghost: 'bg-transparent border-transparent text-danger hover:bg-danger/10',
  },
};

const linkRel =
  target === '_blank'
    ? Array.from(new Set([...(rel?.split(/\s+/).filter(Boolean) ?? []), 'noopener', 'noreferrer'])).join(' ')
    : rel;
---

<a
  href={href}
  aria-label={ariaLabel}
  class:list={['not-content', baseButtonClass, sizeClasses[size], variantClasses[tone][variant], className]}
  target={target}
  rel={linkRel}
>
  {icon && iconPlacement === 'start' && <Icon name={icon} size="1em" />}
  {label ? <span>{label}</span> : <slot />}
  {icon && iconPlacement === 'end' && <Icon name={icon} size="1em" />}
</a>

<style>
  a,
  a:hover {
    text-decoration: none;
  }

  a :global(svg) {
    flex-shrink: 0;
    margin: 0;
  }
</style>
